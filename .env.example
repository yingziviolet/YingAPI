# 复制为 .env 并填写。所有配置项见 app/config.py
# Fernet 密钥(必填,生成:python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
GW_SECRET_KEY=
# 控制面管理 token(必填,自己生成个随机串)
GW_ADMIN_TOKEN=
# 本地开发默认 SQLite;Docker Compose 里由 compose 覆盖为 Postgres
# GW_DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# GW_CACHE_TTL_SECONDS=3600
